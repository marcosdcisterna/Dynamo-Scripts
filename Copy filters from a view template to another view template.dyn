{
  "Uuid": "d60664ee-f76b-4a76-9bc1-ed305ef1391a",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Copy filters from a view template to another view template",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "eaabff91f0f543639c43635a8cd609af",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "ce89dcaef5094a4583b8065865715a93",
          "Name": "_sourceView",
          "Description": "_sourceView",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ed18448a13b24359a7e7bdbc2c5d6e55",
          "Name": "",
          "Description": "_sourceView",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Permite creación directa de código de DesignScript",
      "Code": "/*The view that has the filters*/\n_sourceView: var[]..[];"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "7b11efbc6e754059a96dcac899b4c69c",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "2cf4a87635a14ad190402bd120481f50",
          "Name": "_targetViews",
          "Description": "_targetViews",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "56227df1581242be9badf535990d162f",
          "Name": "",
          "Description": "_targetViews",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Permite creación directa de código de DesignScript",
      "Code": "/*Views to apply filters*/\n_targetViews: var[]..[];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Developed by C2A Services - BIM Specialist Marcos Cisterna\r\n\r\nimport clr\r\n\r\n# Load Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nimport Autodesk\r\n\r\n# Load document reference\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef toList(input):\r\n    \"\"\"Return iterable if available, a list of 1 otherwise\"\"\"\r\n    if hasattr(input, \"__iter__\") and not isinstance(input, str):  # Cambié basestring por str\r\n        return input\r\n    else:\r\n        return [input]\r\n\r\n# Documento activo\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Obtener la vista fuente y las vistas objetivo\r\nsourceView = UnwrapElement(IN[0])\r\ntargetViews = toList(UnwrapElement(IN[1]))\r\n\r\n# Verificar si la vista fuente es válida\r\nif sourceView is None:\r\n    raise ValueError(\"La vista fuente (sourceView) no es válida. Asegúrate de que se ha proporcionado una vista válida.\")\r\n\r\n# Obtener los filtros de la vista fuente\r\nsourceViewFiltersId = sourceView.GetFilters()\r\nfilters = [doc.GetElement(id) for id in sourceViewFiltersId]\r\nfiltersOverrides = [sourceView.GetFilterOverrides(f.Id) for f in filters]\r\nfiltersVisibility = [sourceView.GetFilterVisibility(f.Id) for f in filters]\r\n\r\n# Listas para almacenar plantillas exitosas y vistas sin plantillas\r\nfList = []\r\neList = []\r\n\r\n# Iniciar la transacción\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor tV in targetViews:\r\n    try:\r\n        # Comprobar si la vista tiene una plantilla de vista aplicada\r\n        targetTemplateId = tV.ViewTemplateId\r\n        if targetTemplateId != ElementId.InvalidElementId:\r\n            # Si la vista tiene una plantilla, trabajar directamente con la plantilla\r\n            targetTemplate = doc.GetElement(targetTemplateId)\r\n            if targetTemplate is not None:\r\n                # Aplicar filtros a la plantilla de vista\r\n                for f, override, visibility in zip(filters, filtersOverrides, filtersVisibility):\r\n                    if not targetTemplate.IsFilterApplied(f.Id):\r\n                        targetTemplate.AddFilter(f.Id)\r\n                    targetTemplate.SetFilterOverrides(f.Id, override)\r\n                    targetTemplate.SetFilterVisibility(f.Id, visibility)\r\n                \r\n                # Añadir la plantilla a la lista de éxito\r\n                fList.append(targetTemplate)\r\n        else:\r\n            # Si la vista no tiene plantilla, añadir a la lista de error\r\n            eList.append(tV)\r\n    except Exception as e:\r\n        # Log o print de error para depuración\r\n        import traceback\r\n        print(\"Error applying filters to view template for view {}: {}\".format(tV.Id, traceback.format_exc()))\r\n        eList.append(tV)\r\n\r\n# Finalizar la transacción\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Salida\r\nOUT = [fList, eList]\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "49fd8fa5d678452e99d98103418055c9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "1012a61353a046199da8285be23c881b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6fbb37ec18074872b6ae85b57a2bd1fa",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ad566bb3ea40442e813a24f6a749bd8d",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
