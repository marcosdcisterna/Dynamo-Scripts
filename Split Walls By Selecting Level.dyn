    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "Run;",
      "Id": "4f1bb79e3dc4437a96a208bfbc293480",
      "Inputs": [
        {
          "Id": "4184817671b74ba8bd3542b0cc851295",
          "Name": "Run",
          "Description": "Run",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "59e88251642440f7934732d4c9a59289",
          "Name": "",
          "Description": "Value of expression at line 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\n\nclr.AddReference(\"RevitServices\")\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nclr.AddReference(\"RevitNodes\")\nimport Revit\nclr.ImportExtensions(Revit.Elements)\nclr.ImportExtensions(Revit.GeometryConversion)\n\nclr.AddReference(\"RevitAPI\")\nfrom Autodesk.Revit.DB import *\n\n############## Definitions Start ##############\n# Convert to List if singleton...\ndef tolist(obj1):\n    if hasattr(obj1,\"__iter__\"): \n        return obj1\n    else: \n        return [obj1]\n\n# Create a new wall segment from the base to the target level\ndef CreateWallSegment(wall, base_level, top_level):\n    new_wall = None\n    try:\n        # Copiar el muro original\n        new_wall_id = ElementTransformUtils.CopyElement(doc, wall.Id, XYZ(0, 0, 0))[0]\n        new_wall = doc.GetElement(new_wall_id)\n\n        # Ajustar la restricción base\n        base_param = new_wall.get_Parameter(BuiltInParameter.WALL_BASE_CONSTRAINT)\n        base_param.Set(base_level.Id)\n\n        # Ajustar la restricción superior\n        top_param = new_wall.get_Parameter(BuiltInParameter.WALL_HEIGHT_TYPE)\n        top_param.Set(top_level.Id)\n\n    except Exception as e:\n        return str(e)\n    \n    return new_wall\n\n############## Definitions End ##############\n\n# IN-Variables...\nrun = tolist(IN[0])[0]\nwalls = tolist(UnwrapElement(IN[1]))\ntarget_level = UnwrapElement(IN[2])  # Nivel seleccionado\n\n# OUT-Variables...\noutList = []\n\n# Main Script...\nif run:\n    # Start a new transaction for modifying the document...\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    \n    for wall in walls:\n        # Verificar que el elemento sea un muro\n        if isinstance(wall, Wall):\n            # Obtener los niveles base y tope del muro\n            base_level_id = wall.get_Parameter(BuiltInParameter.WALL_BASE_CONSTRAINT).AsElementId()\n            top_level_id = wall.get_Parameter(BuiltInParameter.WALL_HEIGHT_TYPE).AsElementId()\n\n            base_level = doc.GetElement(base_level_id)\n            top_level = doc.GetElement(top_level_id)\n\n            # Comprobar que el nivel objetivo esté entre el nivel base y el tope\n            if base_level.Elevation < target_level.Elevation < top_level.Elevation:\n                # Crear un nuevo segmento del muro desde el nivel base hasta el nivel objetivo\n                lower_wall = CreateWallSegment(wall, base_level, target_level)\n\n                # Crear otro segmento del muro desde el nivel objetivo hasta el tope original\n                upper_wall = CreateWallSegment(wall, target_level, top_level)\n\n                # Agregar ambos muros a la lista de salida\n                outList.append(lower_wall)\n                outList.append(upper_wall)\n\n                # Eliminar el muro original\n                doc.Delete(wall.Id)\n\n    # Finalizar la transacción\n    TransactionManager.Instance.TransactionTaskDone()\n\n    # Devolver los muros cortados\n    OUT = outList\nelse:\n    OUT = \"Please Set Run to True\"\n\n\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "d0267814809245e59bb1e704cd65ce64",
      "Inputs": [
        {
          "Id": "d301d811ffba41c6ba6778b79262359a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "79f4ff1a2f254ae18d62de213a19eb4b",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8fbfbccc328546b7991e459eddbd73ca",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8245d665354842f4a5ec92a682593054",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
